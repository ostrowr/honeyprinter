{
  "name": "honeyprinter-cloud",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local-upstream localhost --test-scheduled --var SUMMARY_MODE:mock",
    "check": "tsc --project tsconfig.json && tsc --project tsconfig.client.json && tsc --project tsconfig.node.json && npm run build:client",
    "test": "node --test tests/*.test.ts",
    "migrate:local": "wrangler d1 migrations apply honeyprinter --local",
    "deploy:ci": "node scripts/deploy.ts",
    "build:client": "node scripts/build-client.ts"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261008.1",
    "@types/node": "24.19.1",
    "@types/three": "0.186.0",
    "esbuild": "0.28.1",
    "miniflare": "5.20261006.0-alpha",
    "three": "0.186.1",
    "typescript": "^5.9.3",
    "wrangler": "4.148.0"
  },
  "overrides": {
    "sharp": "^0.35.5"
  }
}
