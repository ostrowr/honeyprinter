{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "honeyprinter",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-08",
  "account_id": "2a4721a7e3192e5ad893a8684bb2d2e3",
  "workers_dev": true,
  "routes": [
    {"pattern": "ostro.ws/honeyprinter*", "zone_name": "ostro.ws"},
    {"pattern": "honeyprinter.com", "custom_domain": true},
    {"pattern": "www.honeyprinter.com", "custom_domain": true},
    {"pattern": "api.honeyprinter.com", "custom_domain": true}
  ],
  "build": {"command": "npm run build:client", "watch_dir": ["src", "shared", "client", "scripts/build-client.ts"]},
  "assets": {"directory": "./public", "binding": "ASSETS", "run_worker_first": true},
  "d1_databases": [{"binding": "DB", "database_name": "honeyprinter", "database_id": "0e787731-dc8c-48c9-bf83-107f1e564529", "migrations_dir": "migrations"}],
  "queues": {"producers": [{"binding": "PRINT_QUEUE", "queue": "honeyprinter-print"}]},
  "triggers": {"crons": ["* * * * *"]},
  "vars": {"SUMMARY_MODE": "openai", "OPENAI_MODEL": "gpt-6-luna", "RETENTION_DAYS": "7"},
  "observability": {"enabled": true, "head_sampling_rate": 0.1}
}
