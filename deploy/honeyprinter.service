[Unit]
Description=Honeyprinter protocol decoys
After=network-online.target
Wants=network-online.target

[Service]
User=honeyprinter
Group=honeyprinter
WorkingDirectory=/var/lib/honeyprinter
EnvironmentFile=/etc/honeyprinter.env
ExecStart=/usr/local/bin/honeyprinter --bind 0.0.0.0 --port-offset 0 --ingest-url https://ostro.ws/honeyprinter/api/probes --outbox /var/lib/honeyprinter/outbox.sqlite
Restart=on-failure
RestartSec=5
StateDirectory=honeyprinter
UMask=0077
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
TimeoutStopSec=90
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
